rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function superAdmin() { return signedIn() && request.auth.token.role == 'superAdmin'; }
  function manager(cid) { return superAdmin() || (signedIn() && request.auth.token.role == 'owner' && request.auth.token.circleId == cid); }
  function teacher(cid) { return signedIn() && request.auth.token.role == 'teacher' && request.auth.token.circleId == cid && request.auth.token.teacherId is string; }
  function ownRecord(cid) { return teacher(cid) && resource.data.teacherId == request.auth.token.teacherId; }
  match /circles/{cid} {
   allow read: if manager(cid) || teacher(cid);
   allow write: if false;
   match /teachers/{tid} { allow read: if manager(cid) || (teacher(cid) && tid == request.auth.token.teacherId); allow write: if false; }
   match /students/{sid} { allow read: if manager(cid) || ownRecord(cid); allow write: if false; }
   match /studentAttendance/{id} { allow read: if manager(cid) || ownRecord(cid); allow write: if false; }
   match /teacherAttendance/{id} { allow read: if manager(cid) || ownRecord(cid); allow write: if false; }
   match /academicProgress/{id} { allow read: if manager(cid) || ownRecord(cid); allow write: if false; }
   match /incentiveItems/{id} { allow read: if manager(cid) || teacher(cid); allow write: if false; }
   match /incentiveLedger/{id} { allow read: if manager(cid); allow write: if false; }
  }
  match /{path=**}/students/{id} { allow read: if superAdmin(); }
  match /{path=**}/teachers/{id} { allow read: if superAdmin(); }
  match /{path=**}/studentAttendance/{id} { allow read: if superAdmin(); }
  match /{path=**} { allow write: if false; }
 }
}

